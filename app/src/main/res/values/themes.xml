<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NammaPlatform" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorSecondaryVariant">@color/accent_yellow_dark</item>
        <item name="colorOnSecondary">@color/primary_blue</item>
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.NammaPlatform.Splash" parent="Theme.NammaPlatform">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
    </style>

    <style name="Theme.NammaPlatform.NoActionBar" parent="Theme.NammaPlatform">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
